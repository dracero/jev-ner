# ==============================================================================
# TypeSafe Jev System One - Configuración de API Key
# ==============================================================================
# Ingrese su API Key obtenida en TypeSafe / Jev Console:
JEV_API_KEY=tu_api_key_de_typesafe

# ==============================================================================
# Observabilidad y Trazas con LangSmith (Opcional)
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=tu_api_key_de_langsmith
LANGSMITH_PROJECT=jev_ner_test

# Compatibilidad con SDK LangChain / LangSmith V2
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=tu_api_key_de_langsmith
LANGCHAIN_PROJECT=jev_ner_test

