---
// JevNER - Fullstack Student Survey Moderation & NER/PER Engine
import '../styles/index.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JevNER • Moderador & Anonimizador de Encuestas Estudiantiles</title>
  <meta name="description" content="Aplicación fullstack con TypeSafe Jev para NER, PER, detección de insultos y anonimización de encuestas universitarias antes de su publicación." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-container">
    <!-- Top Header -->
    <header class="app-header">
      <div class="brand-wrapper">
        <div class="brand-icon">J</div>
        <div class="brand-text">
          <h1>JevNER • Anonimizador de Encuestas</h1>
          <p>NER, PER y Moderación Inteligente con TypeSafe Jev System One</p>
        </div>
      </div>
      <div class="header-status-badge" id="api-status-badge">
        <div class="pulse-dot" id="status-dot"></div>
        <span id="api-status-text">Conectando con Backend...</span>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="tabs-nav" aria-label="Navegación principal">
      <button class="tab-btn active" id="tab-btn-process" data-target="panel-process">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        1. Encuesta & Procesamiento
      </button>
      <button class="tab-btn" id="tab-btn-results" data-target="panel-results">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        2. Tabla de Moderación & NER
      </button>
      <button class="tab-btn" id="tab-btn-audit" data-target="panel-audit">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        🎯 3. Auditoría & Filtros Específicos (5 Reportes)
      </button>
      <button class="tab-btn" id="tab-btn-playground" data-target="panel-playground">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        4. Probar Comentario (Playground)
      </button>
      <button class="tab-btn" id="tab-btn-export" data-target="panel-export">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        5. Exportar Dataset Limpio
      </button>
    </nav>

    <!-- PANEL 1: Cargar y Procesar -->
    <section id="panel-process" class="tab-panel">
      <div class="grid-2">
        <!-- Upload Card -->
        <div class="glass-card">
          <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            Cargar Encuesta (.csv o .xlsx)
          </h2>
          <p class="card-desc">Suba la planilla de respuestas de la encuesta estudiantil o use el conjunto de ejemplo.</p>
          
          <div class="dropzone" id="file-dropzone">
            <input type="file" id="file-input" accept=".csv, .xlsx, .xls" />
            <div class="dropzone-icon">📁</div>
            <h3 id="dropzone-text">Arrastre aquí su archivo .csv o .xlsx</h3>
            <p>o haga clic para seleccionar desde su equipo</p>
          </div>

          <div style="margin-top: 16px; display: flex; gap: 10px; align-items: center;">
            <button class="btn btn-outline" id="btn-load-sample" style="width: 100%;">
              ⚡ Cargar Encuesta de Ejemplo (10 Respuestas Reales)
            </button>
          </div>

          <div id="file-loaded-info" style="display: none; margin-top: 16px; padding: 12px 16px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong id="info-filename" style="color: #34d399;">archivo.xlsx</strong>
                <div style="font-size: 0.8rem; color: var(--text-muted);"><span id="info-total-rows">0</span> filas detectadas</div>
              </div>
              <span class="badge-pill true" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.4);">Listo</span>
            </div>
          </div>
        </div>

        <!-- Configuration Card -->
        <div class="glass-card">
          <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            Parámetros de Anonimización & Jev
          </h2>
          <p class="card-desc">Seleccione la hoja de cálculo, la columna de ID y la columna de respuestas para moderar y auditar.</p>

          <div class="form-group" id="sheet-selector-group" style="display: none;">
            <label class="form-label" for="select-sheet">Hoja de Cálculo Activa:</label>
            <select id="select-sheet" class="form-select">
              <option value="">Cargue un archivo primero...</option>
            </select>
          </div>

          <div class="grid-2" style="gap: 12px; margin-bottom: 12px;">
            <div class="form-group">
              <label class="form-label" for="select-id-column">Columna de ID / Identificador:</label>
              <select id="select-id-column" class="form-select" disabled>
                <option value="">Cargue un archivo...</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="select-text-column">Columna de Comentarios:</label>
              <select id="select-text-column" class="form-select" disabled>
                <option value="">Cargue un archivo...</option>
              </select>
            </div>
          </div>

          <label class="checkbox-row" for="chk-mask-per">
            <input type="checkbox" id="chk-mask-per" checked />
            <div class="checkbox-info">
              <span class="checkbox-title">Anonimizar Nombres de Personas (PER)</span>
              <span class="checkbox-desc">Reemplaza nombres y apellidos de profesores y alumnos por [DOCENTE_N]</span>
            </div>
          </label>

          <label class="checkbox-row" for="chk-mask-chair">
            <input type="checkbox" id="chk-mask-chair" checked />
            <div class="checkbox-info">
              <span class="checkbox-title">Anonimizar Cátedras & Materias</span>
              <span class="checkbox-desc">Oculta nombres de asignaturas específicas por [CÁTEDRA_N]</span>
            </div>
          </label>

          <label class="checkbox-row" for="chk-mask-insults">
            <input type="checkbox" id="chk-mask-insults" checked />
            <div class="checkbox-info">
              <span class="checkbox-title">Censurar Insultos & Lenguaje Ofensivo</span>
              <span class="checkbox-desc">Sustituye agresiones e improperios por [LENGUAJE INAPROPIADO]</span>
            </div>
          </label>

          <div style="margin-top: 20px; display: flex; flex-direction: column; gap: 8px;">
            <button class="btn btn-primary" id="btn-start-analysis" style="width: 100%;" disabled>
              <span id="btn-analysis-icon">🚀</span>
              <span id="btn-analysis-text">Ejecutar Análisis con TypeSafe Jev</span>
            </button>
            <button class="btn btn-outline" id="btn-quick-audit" style="width: 100%;" disabled>
              <span>🎯 Ir Directo a la Auditoría de los 5 Criterios</span>
            </button>
          </div>

          <div id="analysis-progress-container" style="display: none; margin-top: 14px;">
            <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted);">
              <span id="progress-step-text">Procesando con Jev System One...</span>
              <span id="progress-percent-text">0%</span>
            </div>
            <div class="progress-bar-container">
              <div class="progress-bar-fill" id="progress-fill" style="width: 0%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Preview of uploaded raw data -->
      <div class="glass-card" id="preview-raw-card" style="display: none;">
        <h3 class="card-title">Vista Previa del Archivo Original (Primeras 5 filas)</h3>
        <p class="card-desc">Verifique que las columnas coincidan antes de ejecutar la moderación.</p>
        <div class="table-responsive">
          <table class="moderation-table" id="table-raw-preview">
            <thead id="raw-preview-thead"></thead>
            <tbody id="raw-preview-tbody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- PANEL 2: Resultados & Moderación -->
    <section id="panel-results" class="tab-panel" style="display: none;">
      <!-- KPI Stats -->
      <div class="grid-kpi">
        <div class="kpi-card kpi-info">
          <div class="kpi-label">Total Analizados</div>
          <div class="kpi-value" id="kpi-total">0</div>
          <div class="kpi-sub">Comentarios en la encuesta</div>
        </div>
        <div class="kpi-card kpi-warning">
          <div class="kpi-label">Nombres (PER)</div>
          <div class="kpi-value" id="kpi-per">0</div>
          <div class="kpi-sub">Docentes o personas detectadas</div>
        </div>
        <div class="kpi-card kpi-purple">
          <div class="kpi-label">Cátedras / Materias</div>
          <div class="kpi-value" id="kpi-chairs">0</div>
          <div class="kpi-sub">Menciones de materias específicas</div>
        </div>
        <div class="kpi-card kpi-danger">
          <div class="kpi-label">Insultos / Agresiones</div>
          <div class="kpi-value" id="kpi-insults">0</div>
          <div class="kpi-sub">Comentarios ofensivos detectados</div>
        </div>
        <div class="kpi-card kpi-success">
          <div class="kpi-label">Aprobados Directos</div>
          <div class="kpi-value" id="kpi-approved">0</div>
          <div class="kpi-sub">Listos para publicar sin cambios</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Toxicidad Promedio</div>
          <div class="kpi-value" id="kpi-toxicity">1.0</div>
          <div class="kpi-sub">Escala Jev 1 a 5</div>
        </div>
      </div>

      <!-- Main Moderation Table Card -->
      <div class="glass-card">
        <div class="filter-bar">
          <div class="filter-buttons">
            <button class="filter-pill active" data-filter="all">Todos (<span id="filter-cnt-all">0</span>)</button>
            <button class="filter-pill" data-filter="per">Docentes / PER (<span id="filter-cnt-per">0</span>)</button>
            <button class="filter-pill" data-filter="chair">Cátedras (<span id="filter-cnt-chair">0</span>)</button>
            <button class="filter-pill" data-filter="insult">Insultos (<span id="filter-cnt-insult">0</span>)</button>
            <button class="filter-pill" data-filter="approved">Aprobados (<span id="filter-cnt-approved">0</span>)</button>
            <button class="filter-pill" data-filter="discard">Descartar / Severos (<span id="filter-cnt-discard">0</span>)</button>
          </div>
          <div class="search-input-wrapper">
            <span class="search-icon">🔍</span>
            <input type="text" id="search-input" class="form-input" placeholder="Buscar en respuestas..." />
          </div>
        </div>

        <div class="table-responsive">
          <table class="moderation-table" id="results-table">
            <thead>
              <tr>
                <th style="width: 50px;">#</th>
                <th style="min-width: 280px;">Comentario Original (Entidades Resaltadas)</th>
                <th style="min-width: 280px;">Versión Anonimizada para Publicación</th>
                <th>Decisión Jev (PER / Cátedra / Insulto)</th>
                <th>Toxicidad</th>
                <th>Tema</th>
                <th>Acción / Publicar</th>
              </tr>
            </thead>
            <tbody id="results-tbody">
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-dim); padding: 40px;">
                  No hay datos procesados aún. Cargue una encuesta en la pestaña "Encuesta & Procesamiento".
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- PANEL 3: Auditoría & Filtros Específicos (5 Reportes) -->
    <section id="panel-audit" class="tab-panel" style="display: none;">
      <div class="sheet-selector-bar">
        <div style="flex: 1; min-width: 240px;">
          <strong style="color: var(--text-main); font-size: 1.05rem;">Auditoría de Encuestas & Criterios Específicos</strong>
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">
            Hoja activa: <span id="audit-active-sheet" style="color: #818cf8; font-weight: 600;">Comentarios 2026 1C</span> • 
            Columna ID: <span id="audit-active-id-col" style="color: #34d399; font-weight: 600;">id_encuesta</span> • 
            Total filas: <span id="audit-total-rows" style="font-weight: 600;">0</span>
          </div>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button class="btn btn-primary" id="btn-run-audit-now">
            <span>⚡ Ejecutar / Actualizar Auditoría</span>
          </button>
          <button class="btn btn-outline" id="btn-export-full-excel">
            <span>📦 Descargar Excel Consolidado (5 Hojas)</span>
          </button>
        </div>
      </div>

      <div class="audit-section">
        <!-- 1. Tratos inapropiados, maliciosos, faltas de respeto, insultos o que hablan mal de personas -->
        <div class="audit-card">
          <div class="audit-card-header">
            <div class="audit-card-title-group">
              <div class="audit-card-title">
                <span>1. Tratos inapropiados, maliciosos, faltas de respeto, insultos o hablar mal de personas</span>
                <span class="badge-counter alert" id="badge-disrespect-count">0 encontrados</span>
              </div>
              <p class="audit-card-desc">Detalle de IDs en tabla exportable que reportan tratos indebidos o quejas agresivas hacia docentes o personas.</p>
            </div>
            <div class="audit-card-actions">
              <button class="btn-sm btn-primary-sm" id="btn-export-disrespect-csv">📥 Exportar Tabla (CSV)</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="moderation-table">
              <thead>
                <tr>
                  <th style="width: 120px;">ID</th>
                  <th>Comentario</th>
                  <th style="width: 260px;">Detección / Motivo</th>
                </tr>
              </thead>
              <tbody id="tbody-report-disrespect">
                <tr><td colspan="3" style="text-align: center; color: var(--text-dim); padding: 24px;">Cargue un archivo o datos de ejemplo para ver los resultados</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Nombres propios en la hoja seleccionada (ej. Comentarios 2026 1C) -->
        <div class="audit-card">
          <div class="audit-card-header">
            <div class="audit-card-title-group">
              <div class="audit-card-title">
                <span>2. Comentarios donde figuren Nombres Propios</span>
                <span class="badge-counter warning" id="badge-propernames-count">0 encontrados</span>
              </div>
              <p class="audit-card-desc">Detalle de IDs de la hoja <strong id="proper-names-sheet-label" style="color: #818cf8;">Comentarios 2026 1C</strong> donde figuren nombres propios de docentes o personas.</p>
            </div>
            <div class="audit-card-actions">
              <button class="btn-sm btn-primary-sm" id="btn-export-propernames-csv">📥 Exportar Tabla (CSV)</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="moderation-table">
              <thead>
                <tr>
                  <th style="width: 120px;">ID</th>
                  <th style="width: 250px;">Nombres Propios Identificados</th>
                  <th>Comentario</th>
                </tr>
              </thead>
              <tbody id="tbody-report-propernames">
                <tr><td colspan="3" style="text-align: center; color: var(--text-dim); padding: 24px;">Cargue un archivo o datos de ejemplo para ver los resultados</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Términos de la jerga argentina agresiva -->
        <div class="audit-card">
          <div class="audit-card-header">
            <div class="audit-card-title-group">
              <div class="audit-card-title">
                <span>3. Términos Específicos de la Jerga Argentina Agresiva</span>
                <span class="badge-counter alert" id="badge-argslang-count">0 encontrados</span>
              </div>
              <p class="audit-card-desc">Términos buscados (tanto en femenino como en masculino, singular y plural): <em>paja, boludo/a, forro/a, mierda, pelotudo/a, mogólico/a, estúpido/a, garca, choto/a, sorete, conchudo/a, puto/a, pajero/a</em>.</p>
            </div>
            <div class="audit-card-actions">
              <button class="btn-sm btn-primary-sm" id="btn-export-argslang-csv">📥 Exportar Tabla (CSV)</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="moderation-table">
              <thead>
                <tr>
                  <th style="width: 120px;">ID</th>
                  <th style="width: 240px;">Término(s) Jerga Detectado(s)</th>
                  <th>Comentario</th>
                </tr>
              </thead>
              <tbody id="tbody-report-argslang">
                <tr><td colspan="3" style="text-align: center; color: var(--text-dim); padding: 24px;">Cargue un archivo o datos de ejemplo para ver los resultados</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. Connotación política, discriminación y/o cuestiones de género -->
        <div class="audit-card">
          <div class="audit-card-header">
            <div class="audit-card-title-group">
              <div class="audit-card-title">
                <span>4. Connotación Política, Discriminación y/o Cuestiones de Género</span>
                <span class="badge-counter warning" id="badge-political-count">0 IDs</span>
              </div>
              <p class="audit-card-desc">Listado de IDs (uno por fila) de comentarios que tengan connotación política, discriminación y/o cuestiones de género.</p>
            </div>
            <div class="audit-card-actions">
              <button class="btn-sm" id="btn-copy-political-ids">📋 Copiar IDs</button>
              <button class="btn-sm btn-primary-sm" id="btn-download-political-txt">📥 Descargar Lista (TXT)</button>
            </div>
          </div>
          <div class="grid-2" style="gap: 16px;">
            <div>
              <label class="form-label">Lista de IDs (uno por fila):</label>
              <div class="id-list-box" id="list-political-ids">(Sin IDs coincidentes en la hoja actual)</div>
            </div>
            <div>
              <label class="form-label">Detalle de Comentarios Identificados:</label>
              <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                <table class="moderation-table" style="font-size: 0.82rem;">
                  <thead>
                    <tr><th style="width: 70px;">ID</th><th style="width: 140px;">Categoría</th><th>Comentario</th></tr>
                  </thead>
                  <tbody id="tbody-detail-political">
                    <tr><td colspan="3" style="color: var(--text-dim); text-align: center;">Ningún comentario con este criterio</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- 5. Comentarios de más de 120 palabras con connotación negativa -->
        <div class="audit-card">
          <div class="audit-card-header">
            <div class="audit-card-title-group">
              <div class="audit-card-title">
                <span>5. Comentarios de Más de 120 Palabras con Connotación Negativa</span>
                <span class="badge-counter" id="badge-longneg-count">0 IDs</span>
              </div>
              <p class="audit-card-desc">Listado de IDs (uno por fila) con comentarios extensos (&gt; 120 palabras) y tono/connotación negativa.</p>
            </div>
            <div class="audit-card-actions">
              <button class="btn-sm" id="btn-copy-longneg-ids">📋 Copiar IDs</button>
              <button class="btn-sm btn-primary-sm" id="btn-download-longneg-txt">📥 Descargar Lista (TXT)</button>
            </div>
          </div>
          <div class="grid-2" style="gap: 16px;">
            <div>
              <label class="form-label">Lista de IDs (uno por fila):</label>
              <div class="id-list-box" id="list-longneg-ids">(Sin comentarios de más de 120 palabras con connotación negativa)</div>
            </div>
            <div>
              <label class="form-label">Detalle de Comentarios Identificados:</label>
              <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                <table class="moderation-table" style="font-size: 0.82rem;">
                  <thead>
                    <tr><th style="width: 70px;">ID</th><th style="width: 90px;">Palabras</th><th>Comentario</th></tr>
                  </thead>
                  <tbody id="tbody-detail-longneg">
                    <tr><td colspan="3" style="color: var(--text-dim); text-align: center;">Ningún comentario supera las 120 palabras</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PANEL 4: Playground / Prueba Individual -->
    <section id="panel-playground" class="tab-panel" style="display: none;">
      <div class="glass-card">
        <h2 class="card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          Playground de Evaluación Inmediata Jev
        </h2>
        <p class="card-desc">Pruebe comentarios de alumnos en tiempo real para calibrar cómo responde el modelo System One.</p>

        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px;">
          <span style="font-size: 0.8rem; color: var(--text-muted); align-self: center;">Ejemplos rápidos:</span>
          <button class="filter-pill sample-prompt-btn" data-text="El profesor Juan Perez de Algoritmos es un desastre y un idiota total.">Insulto a docente</button>
          <button class="filter-pill sample-prompt-btn" data-text="Excelente la cursada de Sistemas Operativos, los prácticos fueron muy claros.">Elogio con cátedra</button>
          <button class="filter-pill sample-prompt-btn" data-text="La ayudante Florencia Fernández tiene muy buena onda en las consultas.">Mención de ayudante (PER)</button>
          <button class="filter-pill sample-prompt-btn" data-text="El parcial fue excesivamente largo y no alcanzó el tiempo estipulado.">Queja constructiva</button>
        </div>

        <div class="form-group">
          <textarea id="single-text-input" class="form-textarea" rows="3" placeholder="Escriba o pegue una respuesta de alumno aquí..."></textarea>
        </div>

        <button class="btn btn-primary" id="btn-run-single">
          <span>⚡ Analizar con TypeSafe Jev (100ms)</span>
        </button>

        <div id="single-result-box" style="display: none; margin-top: 24px;">
          <div class="grid-2">
            <div>
              <label class="form-label">Texto Original con Entidades:</label>
              <div id="single-highlighted" style="padding: 14px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 8px; min-height: 80px; line-height: 1.6;"></div>
            </div>
            <div>
              <label class="form-label">Resultado Anonimizado para Publicación:</label>
              <div id="single-anonymized" class="anonymized-box" style="min-height: 80px; line-height: 1.6;"></div>
            </div>
          </div>

          <div style="margin-top: 20px; padding: 16px; background: rgba(15, 23, 42, 0.5); border: 1px solid var(--border-color); border-radius: 8px;">
            <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--text-main);">Juicios Estructurados del Modelo Jev:</h4>
            <div style="display: flex; gap: 16px; flex-wrap: wrap;" id="single-metrics-chips">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PANEL 4: Exportación -->
    <section id="panel-export" class="tab-panel" style="display: none;">
      <div class="glass-card" style="max-width: 800px; margin: 0 auto;">
        <h2 class="card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Exportar Encuesta Limpia y Anonimizada
        </h2>
        <p class="card-desc">Descargue el conjunto de datos listo para publicación institucional o análisis público.</p>

        <div class="form-group">
          <label class="form-label">Formato de Archivo:</label>
          <div style="display: flex; gap: 16px;">
            <label class="checkbox-row" style="flex: 1;" for="export-fmt-xlsx">
              <input type="radio" name="export-format" id="export-fmt-xlsx" value="xlsx" checked />
              <div class="checkbox-info">
                <span class="checkbox-title">Microsoft Excel (.xlsx)</span>
                <span class="checkbox-desc">Ideal para reportes institucionales</span>
              </div>
            </label>
            <label class="checkbox-row" style="flex: 1;" for="export-fmt-csv">
              <input type="radio" name="export-format" id="export-fmt-csv" value="csv" />
              <div class="checkbox-info">
                <span class="checkbox-title">Archivo CSV (.csv UTF-8)</span>
                <span class="checkbox-desc">Compatible con Python, R, SPSS y BI</span>
              </div>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Estructura de Columnas para Exportación:</label>
          <select id="export-mode-select" class="form-select">
            <option value="replace_original">Reemplazar columna original con el texto anonimizado (Más limpio)</option>
            <option value="add_anonymized_col">Conservar columna original y agregar [columna]_anonimizado</option>
            <option value="all_metadata">Incluir texto anonimizado + Columnas de Auditoría Jev (Toxicidad, PER, Insulto, Tema)</option>
          </select>
        </div>

        <label class="checkbox-row" for="chk-exclude-discarded">
          <input type="checkbox" id="chk-exclude-discarded" checked />
          <div class="checkbox-info">
            <span class="checkbox-title">Excluir comentarios descartados / ofensas severas</span>
            <span class="checkbox-desc">Filtra automáticamente respuestas con toxicidad alta que no aportan al análisis docente</span>
          </div>
        </label>

        <div style="margin-top: 24px;">
          <button class="btn btn-primary" id="btn-do-export" style="width: 100%; font-size: 1rem; padding: 14px;">
            📥 Descargar Planilla Limpia para Publicación
          </button>
        </div>
      </div>
    </section>

    <!-- Notification Toast -->
    <div id="toast" class="toast-msg" style="display: none;">
      <span id="toast-icon">ℹ️</span>
      <span id="toast-text">Mensaje</span>
    </div>
  </div>

  <!-- Client-side Logic -->
  <script>
    const API_BASE = '';
    let currentSessionId = null;
    let currentUploadedRows = [];
    let currentFilename = '';
    let currentSheetNames = ['Sheet1'];
    let currentSelectedSheet = 'Sheet1';
    let currentSheetsData = {};
    let currentAuditResult = null;
    let processedResults = [];
    let currentFilter = 'all';

    // UI Elements
    const apiStatusBadge = document.getElementById('api-status-badge');
    const apiStatusText = document.getElementById('api-status-text');
    const statusDot = document.getElementById('status-dot');

    const fileInput = document.getElementById('file-input');
    const fileDropzone = document.getElementById('file-dropzone');
    const btnLoadSample = document.getElementById('btn-load-sample');
    const fileLoadedInfo = document.getElementById('file-loaded-info');
    const infoFilename = document.getElementById('info-filename');
    const infoTotalRows = document.getElementById('info-total-rows');
    const selectSheet = document.getElementById('select-sheet');
    const sheetSelectorGroup = document.getElementById('sheet-selector-group');
    const selectIdColumn = document.getElementById('select-id-column');
    const selectTextColumn = document.getElementById('select-text-column');
    const btnStartAnalysis = document.getElementById('btn-start-analysis');
    const btnAnalysisText = document.getElementById('btn-analysis-text');
    const btnQuickAudit = document.getElementById('btn-quick-audit');
    const progressContainer = document.getElementById('analysis-progress-container');
    const progressFill = document.getElementById('progress-fill');
    const progressPercentText = document.getElementById('progress-percent-text');
    const progressStepText = document.getElementById('progress-step-text');

    const previewRawCard = document.getElementById('preview-raw-card');
    const rawPreviewThead = document.getElementById('raw-preview-thead');
    const rawPreviewTbody = document.getElementById('raw-preview-tbody');

    const resultsTbody = document.getElementById('results-tbody');
    const searchInput = document.getElementById('search-input');
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');
    const toastIcon = document.getElementById('toast-icon');

    // Audit Panel UI Elements
    const auditActiveSheet = document.getElementById('audit-active-sheet');
    const auditActiveIdCol = document.getElementById('audit-active-id-col');
    const auditTotalRows = document.getElementById('audit-total-rows');
    const btnRunAuditNow = document.getElementById('btn-run-audit-now');
    const btnExportFullExcel = document.getElementById('btn-export-full-excel');

    const badgeDisrespectCount = document.getElementById('badge-disrespect-count');
    const tbodyReportDisrespect = document.getElementById('tbody-report-disrespect');
    const btnExportDisrespectCsv = document.getElementById('btn-export-disrespect-csv');

    const badgePropernamesCount = document.getElementById('badge-propernames-count');
    const properNamesSheetLabel = document.getElementById('proper-names-sheet-label');
    const tbodyReportPropernames = document.getElementById('tbody-report-propernames');
    const btnExportPropernamesCsv = document.getElementById('btn-export-propernames-csv');

    const badgeArgslangCount = document.getElementById('badge-argslang-count');
    const tbodyReportArgslang = document.getElementById('tbody-report-argslang');
    const btnExportArgslangCsv = document.getElementById('btn-export-argslang-csv');

    const badgePoliticalCount = document.getElementById('badge-political-count');
    const listPoliticalIds = document.getElementById('list-political-ids');
    const tbodyDetailPolitical = document.getElementById('tbody-detail-political');
    const btnCopyPoliticalIds = document.getElementById('btn-copy-political-ids');
    const btnDownloadPoliticalTxt = document.getElementById('btn-download-political-txt');

    const badgeLongnegCount = document.getElementById('badge-longneg-count');
    const listLongnegIds = document.getElementById('list-longneg-ids');
    const tbodyDetailLongneg = document.getElementById('tbody-detail-longneg');
    const btnCopyLongnegIds = document.getElementById('btn-copy-longneg-ids');
    const btnDownloadLongnegTxt = document.getElementById('btn-download-longneg-txt');

    // Show Notification Toast
    function showToast(msg, icon = 'ℹ️') {
      toastText.textContent = msg;
      toastIcon.textContent = icon;
      toast.style.display = 'flex';
      setTimeout(() => { toast.style.display = 'none'; }, 4000);
    }

    // Health check
    async function checkHealth() {
      try {
        const res = await fetch(`${API_BASE}/api/status`);
        if (!res.ok) throw new Error();
        const data = await res.json();
        if (data.has_api_key) {
          apiStatusText.textContent = `TypeSafe Jev Conectado (${data.api_key_masked})`;
          statusDot.style.background = '#10b981';
          statusDot.style.boxShadow = '0 0 10px #10b981';
        } else {
          apiStatusText.textContent = 'Backend Online (Falta JEV_API_KEY)';
          statusDot.style.background = '#f59e0b';
        }
      } catch (e) {
        apiStatusText.textContent = 'Backend Desconectado';
        statusDot.style.background = '#ef4444';
      }
    }

    checkHealth();

    // Tab Switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
        btn.classList.add('active');
        const targetId = btn.getAttribute('data-target');
        const panel = document.getElementById(targetId);
        if (panel) panel.style.display = 'block';
      });
    });

    // Populate Sheets
    function populateSheets(sheetNames, selected) {
      if (!sheetNames || sheetNames.length <= 1) {
        sheetSelectorGroup.style.display = 'none';
        return;
      }
      sheetSelectorGroup.style.display = 'block';
      selectSheet.innerHTML = '';
      sheetNames.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s;
        if (s === selected) opt.selected = true;
        selectSheet.appendChild(opt);
      });
    }

    selectSheet?.addEventListener('change', () => {
      const chosen = selectSheet.value;
      if (!chosen || !currentSheetsData[chosen]) return;
      currentSelectedSheet = chosen;
      currentUploadedRows = currentSheetsData[chosen];
      infoTotalRows.textContent = currentUploadedRows.length;
      if (currentUploadedRows.length > 0) {
        const cols = Object.keys(currentUploadedRows[0]);
        populateIdColumns(cols);
        populateColumns(cols);
        renderRawPreview(cols, currentUploadedRows.slice(0, 5));
      }
      runAudit();
      showToast(`Cambiado a hoja: ${chosen}`, '📄');
    });

    // Populate ID Column Select
    function populateIdColumns(columns, suggestedId) {
      selectIdColumn.innerHTML = '';
      const candidateNames = ['id_encuesta', 'id', 'id_fila', 'identificador', 'numero', 'nro', '#', 'estudiante_id', 'codigo'];
      let bestMatch = suggestedId;
      if (!bestMatch) {
        bestMatch = columns.find(c => candidateNames.includes(c.toLowerCase().trim()))
          || columns.find(c => c.toLowerCase().includes('id'))
          || columns[0];
      }

      columns.forEach(col => {
        const opt = document.createElement('option');
        opt.value = col;
        opt.textContent = col === bestMatch ? `${col} (ID)` : col;
        if (col === bestMatch) opt.selected = true;
        selectIdColumn.appendChild(opt);
      });
      selectIdColumn.disabled = false;
    }

    // Populate Column Select
    function populateColumns(columns, suggested) {
      selectTextColumn.innerHTML = '';
      columns.forEach(col => {
        const opt = document.createElement('option');
        opt.value = col;
        opt.textContent = col === suggested ? `${col} (Sugerida)` : col;
        if (col === suggested) opt.selected = true;
        selectTextColumn.appendChild(opt);
      });
      selectTextColumn.disabled = false;
      btnStartAnalysis.disabled = false;
    }

    // Render Raw Preview Table
    function renderRawPreview(columns, previewRows) {
      previewRawCard.style.display = 'block';
      rawPreviewThead.innerHTML = `<tr>${columns.map(c => `<th>${c}</th>`).join('')}</tr>`;
      rawPreviewTbody.innerHTML = previewRows.slice(0, 5).map(row => {
        return `<tr>${columns.map(c => `<td>${row[c] !== undefined ? row[c] : ''}</td>`).join('')}</tr>`;
      }).join('');
    }

    // Handle Upload response
    function handleUploadSuccess(data) {
      currentSessionId = data.session_id;
      currentFilename = data.filename || 'encuesta';
      currentSheetNames = data.sheet_names || ['Sheet1'];
      currentSelectedSheet = data.selected_sheet || currentSheetNames[0];
      currentSheetsData = data.sheets_data || { [currentSelectedSheet]: data.rows || [] };
      currentUploadedRows = data.rows || currentSheetsData[currentSelectedSheet] || [];

      infoFilename.textContent = data.filename;
      infoTotalRows.textContent = currentUploadedRows.length;
      fileLoadedInfo.style.display = 'block';

      populateSheets(currentSheetNames, currentSelectedSheet);
      populateIdColumns(data.columns, data.suggested_id_column);
      populateColumns(data.columns, data.suggested_column);
      renderRawPreview(data.columns, data.preview || currentUploadedRows.slice(0, 5));

      btnStartAnalysis.disabled = false;
      btnQuickAudit.disabled = false;

      // Ejecutar automáticamente la auditoría de los 5 requisitos
      runAudit();
      showToast(`Archivo cargado: ${currentUploadedRows.length} filas analizadas`, '✅');
    }

    selectIdColumn?.addEventListener('change', () => runAudit());
    selectTextColumn?.addEventListener('change', () => runAudit());

    btnQuickAudit?.addEventListener('click', () => {
      document.getElementById('tab-btn-audit').click();
    });

    btnRunAuditNow?.addEventListener('click', () => {
      runAudit();
      showToast('Auditoría actualizada con éxito', '⚡');
    });

    // Run 5-criteria Survey Audit
    async function runAudit() {
      if (!currentUploadedRows || currentUploadedRows.length === 0) return;

      const idCol = selectIdColumn.value || '';
      const textCol = selectTextColumn.value || '';
      const sheet = currentSelectedSheet || 'Comentarios 2026 1C';

      try {
        const res = await fetch(`${API_BASE}/api/audit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            session_id: currentSessionId,
            rows: currentUploadedRows,
            id_column: idCol,
            text_column: textCol,
            sheet_name: sheet
          })
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.detail || 'Error en auditoría');
        }

        const data = await res.json();
        currentAuditResult = data.audit;
        renderAuditReports(currentAuditResult);
      } catch (e) {
        showToast(e.message, '❌');
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Render 5 Audit Reports
    function renderAuditReports(audit) {
      if (!audit) return;
      if (auditActiveSheet) auditActiveSheet.textContent = audit.sheetName;
      if (properNamesSheetLabel) properNamesSheetLabel.textContent = audit.sheetName;
      if (auditActiveIdCol) auditActiveIdCol.textContent = audit.idColumn;
      if (auditTotalRows) auditTotalRows.textContent = audit.totalRows;

      // 1. Tratos inapropiados
      badgeDisrespectCount.textContent = `${audit.reportDisrespect.length} encontrados`;
      if (audit.reportDisrespect.length === 0) {
        tbodyReportDisrespect.innerHTML = `<tr><td colspan="3" style="text-align: center; color: var(--text-dim); padding: 20px;">Sin comentarios con faltas de respeto o tratos inapropiados en esta hoja.</td></tr>`;
      } else {
        tbodyReportDisrespect.innerHTML = audit.reportDisrespect.map(r => `
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 700; color: #f87171;">${r.id}</td>
            <td>${escapeHtml(r.comentario)}</td>
            <td><span class="badge-pill true" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border-color: rgba(239, 68, 68, 0.3);">${escapeHtml(r.detalles || '')}</span></td>
          </tr>
        `).join('');
      }

      // 2. Nombres propios
      badgePropernamesCount.textContent = `${audit.reportProperNames.length} encontrados`;
      if (audit.reportProperNames.length === 0) {
        tbodyReportPropernames.innerHTML = `<tr><td colspan="3" style="text-align: center; color: var(--text-dim); padding: 20px;">Sin nombres propios detectados en la hoja "${escapeHtml(audit.sheetName)}".</td></tr>`;
      } else {
        tbodyReportPropernames.innerHTML = audit.reportProperNames.map(r => `
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 700; color: #fbbf24;">${r.id}</td>
            <td><strong style="color: #fbbf24; font-family: var(--font-mono);">${escapeHtml(r.detalles || '')}</strong></td>
            <td>${escapeHtml(r.comentario)}</td>
          </tr>
        `).join('');
      }

      // 3. Jerga argentina agresiva
      badgeArgslangCount.textContent = `${audit.reportArgSlang.length} encontrados`;
      if (audit.reportArgSlang.length === 0) {
        tbodyReportArgslang.innerHTML = `<tr><td colspan="3" style="text-align: center; color: var(--text-dim); padding: 20px;">Sin términos de la lista especificada en esta hoja.</td></tr>`;
      } else {
        tbodyReportArgslang.innerHTML = audit.reportArgSlang.map(r => `
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 700; color: #f87171;">${r.id}</td>
            <td><span class="badge-pill true" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border-color: rgba(239, 68, 68, 0.4); font-family: var(--font-mono);">${escapeHtml(r.detalles || '')}</span></td>
            <td>${escapeHtml(r.comentario)}</td>
          </tr>
        `).join('');
      }

      // 4. Política, discriminación, género
      const polIds = audit.idsPoliticalGenderDiscrimination || [];
      badgePoliticalCount.textContent = `${polIds.length} IDs`;
      if (polIds.length === 0) {
        listPoliticalIds.textContent = '(Ningún ID coincide con connotación política, discriminación o cuestiones de género)';
        tbodyDetailPolitical.innerHTML = `<tr><td colspan="3" style="color: var(--text-dim); text-align: center;">Ningún comentario con este criterio en las fuentes analizadas</td></tr>`;
      } else {
        listPoliticalIds.textContent = polIds.join('\n');
        tbodyDetailPolitical.innerHTML = (audit.reportPoliticalGenderDiscrimination || []).map(r => `
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 700; color: #818cf8;">${r.id}</td>
            <td><span class="badge-pill true" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc;">${escapeHtml(r.detalles || '')}</span></td>
            <td>${escapeHtml(r.comentario)}</td>
          </tr>
        `).join('');
      }

      // 5. Más de 120 palabras negativas
      const longIds = audit.idsOver120WordsNegative || [];
      badgeLongnegCount.textContent = `${longIds.length} IDs`;
      if (longIds.length === 0) {
        listLongnegIds.textContent = '(Ningún ID contiene comentarios de más de 120 palabras con connotación negativa)';
        tbodyDetailLongneg.innerHTML = `<tr><td colspan="3" style="color: var(--text-dim); text-align: center;">Ningún comentario supera las 120 palabras en las fuentes analizadas</td></tr>`;
      } else {
        listLongnegIds.textContent = longIds.join('\n');
        tbodyDetailLongneg.innerHTML = (audit.reportOver120WordsNegative || []).map(r => `
          <tr>
            <td style="font-family: var(--font-mono); font-weight: 700; color: #f87171;">${r.id}</td>
            <td style="font-family: var(--font-mono);">${r.palabras} palabras</td>
            <td>${escapeHtml(r.comentario)}</td>
          </tr>
        `).join('');
      }
    }

    // Copy and Download Helpers
    function downloadText(content, filename) {
      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
      showToast(`Descargado: ${filename}`, '📥');
    }

    btnCopyPoliticalIds?.addEventListener('click', () => {
      if (!currentAuditResult || currentAuditResult.idsPoliticalGenderDiscrimination.length === 0) {
        showToast('No hay IDs coincidentes para copiar', '⚠️');
        return;
      }
      navigator.clipboard.writeText(currentAuditResult.idsPoliticalGenderDiscrimination.join('\n'));
      showToast('IDs copiados al portapapeles (uno por fila)', '📋');
    });

    btnDownloadPoliticalTxt?.addEventListener('click', () => {
      if (!currentAuditResult) return;
      const text = currentAuditResult.idsPoliticalGenderDiscrimination.join('\n');
      downloadText(text, 'ids_politica_discriminacion_genero.txt');
    });

    btnCopyLongnegIds?.addEventListener('click', () => {
      if (!currentAuditResult || currentAuditResult.idsOver120WordsNegative.length === 0) {
        showToast('No hay IDs coincidentes para copiar', '⚠️');
        return;
      }
      navigator.clipboard.writeText(currentAuditResult.idsOver120WordsNegative.join('\n'));
      showToast('IDs copiados al portapapeles (uno por fila)', '📋');
    });

    btnDownloadLongnegTxt?.addEventListener('click', () => {
      if (!currentAuditResult) return;
      const text = currentAuditResult.idsOver120WordsNegative.join('\n');
      downloadText(text, 'ids_mas_120_palabras_negativas.txt');
    });

    // CSV and Full Excel Export Helpers
    async function downloadAuditExport(target, filename) {
      if (!currentAuditResult) {
        showToast('Ejecute la auditoría primero', '⚠️');
        return;
      }
      try {
        const res = await fetch(`${API_BASE}/api/audit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            rows: currentUploadedRows,
            id_column: selectIdColumn.value,
            text_column: selectTextColumn.value,
            sheet_name: currentSelectedSheet,
            export_target: target
          })
        });
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`Descargado: ${filename}`, '📥');
      } catch (e) {
        showToast('Error al exportar', '❌');
      }
    }

    btnExportDisrespectCsv?.addEventListener('click', () => downloadAuditExport('disrespect_csv', '1_tratos_inapropiados_insultos.csv'));
    btnExportPropernamesCsv?.addEventListener('click', () => downloadAuditExport('proper_names_csv', '2_nombres_propios.csv'));
    btnExportArgslangCsv?.addEventListener('click', () => downloadAuditExport('slang_csv', '3_jerga_argentina.csv'));
    btnExportFullExcel?.addEventListener('click', () => downloadAuditExport('full_excel', 'auditoria_5_reportes_encuestas.xlsx'));


    // Load Sample Dataset
    btnLoadSample.addEventListener('click', async () => {
      btnLoadSample.disabled = true;
      btnLoadSample.textContent = '⏳ Cargando datos de ejemplo...';
      try {
        const res = await fetch(`${API_BASE}/api/sample`);
        const data = await res.json();
        handleUploadSuccess(data);
      } catch (e) {
        showToast('Error al cargar datos de ejemplo', '❌');
      } finally {
        btnLoadSample.disabled = false;
        btnLoadSample.textContent = '⚡ Cargar Encuesta de Ejemplo (10 Respuestas Reales)';
      }
    });

    // File Drop & Selection
    fileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      uploadFile(file);
    });

    fileDropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      fileDropzone.classList.add('dragover');
    });

    fileDropzone.addEventListener('dragleave', () => {
      fileDropzone.classList.remove('dragover');
    });

    fileDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      fileDropzone.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        uploadFile(e.dataTransfer.files[0]);
      }
    });

    async function uploadFile(file) {
      const formData = new FormData();
      formData.append('file', file);
      document.getElementById('dropzone-text').textContent = `Subiendo ${file.name}...`;

      try {
        const res = await fetch(`${API_BASE}/api/upload`, {
          method: 'POST',
          body: formData
        });
        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.detail || 'Error al procesar el archivo');
        }
        const data = await res.json();
        handleUploadSuccess(data);
        document.getElementById('dropzone-text').textContent = file.name;
      } catch (e) {
        showToast(e.message, '❌');
        document.getElementById('dropzone-text').textContent = 'Arrastre aquí su archivo .csv o .xlsx';
      }
    }

    // Execute Batch Analysis
    btnStartAnalysis.addEventListener('click', async () => {
      if (!currentSessionId) return;

      const textColumn = selectTextColumn.value;
      const maskPer = document.getElementById('chk-mask-per').checked;
      const maskChair = document.getElementById('chk-mask-chair').checked;
      const maskInsults = document.getElementById('chk-mask-insults').checked;

      btnStartAnalysis.disabled = true;
      btnAnalysisText.textContent = 'Ejecutando TypeSafe Jev...';
      progressContainer.style.display = 'block';
      progressFill.style.width = '25%';
      progressPercentText.textContent = '25%';
      progressStepText.textContent = 'Enviando preguntas System One a Jev...';

      try {
        const res = await fetch(`${API_BASE}/api/analyze-batch`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            session_id: currentSessionId,
            rows: currentUploadedRows,
            filename: currentFilename,
            text_column: textColumn,
            mask_per: maskPer,
            mask_chair: maskChair,
            mask_insult: maskInsults,
            concurrency: 5
          })
        });

        progressFill.style.width = '80%';
        progressPercentText.textContent = '80%';
        progressStepText.textContent = 'Construyendo máscaras y entidades...';

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.detail || 'Error al ejecutar análisis');
        }

        const data = await res.json();
        processedResults = data.rows;
        
        progressFill.style.width = '100%';
        progressPercentText.textContent = '100%';
        progressStepText.textContent = '¡Completado con éxito!';

        updateKpis(data.kpi);
        renderResultsTable(processedResults);

        showToast(`Análisis completado: ${data.total_analyzed} respuestas moderadas`, '🎉');

        // Switch to Results Tab
        setTimeout(() => {
          document.getElementById('tab-btn-results').click();
        }, 500);

      } catch (e) {
        showToast(e.message, '❌');
      } finally {
        btnStartAnalysis.disabled = false;
        btnAnalysisText.textContent = 'Ejecutar Análisis con TypeSafe Jev';
      }
    });

    // Update KPI UI
    function updateKpis(kpi) {
      document.getElementById('kpi-total').textContent = kpi.total;
      document.getElementById('kpi-per').textContent = kpi.with_person_name;
      document.getElementById('kpi-chairs').textContent = kpi.with_chair_reference;
      document.getElementById('kpi-insults').textContent = kpi.with_insults;
      document.getElementById('kpi-approved').textContent = kpi.approved_direct;
      document.getElementById('kpi-toxicity').textContent = `${kpi.avg_toxicity} / 5`;

      document.getElementById('filter-cnt-all').textContent = kpi.total;
      document.getElementById('filter-cnt-per').textContent = kpi.with_person_name;
      document.getElementById('filter-cnt-chair').textContent = kpi.with_chair_reference;
      document.getElementById('filter-cnt-insult').textContent = kpi.with_insults;
      document.getElementById('filter-cnt-approved').textContent = kpi.approved_direct;
      document.getElementById('filter-cnt-discard').textContent = kpi.action_distribution['descartar'] || 0;
    }

    // Render Results Table
    function renderResultsTable(rows) {
      const q = searchInput.value.toLowerCase().trim();
      const filtered = rows.filter(r => {
        // Filter by Tab/Category
        if (currentFilter === 'per' && !r.jev.has_person_name) return false;
        if (currentFilter === 'chair' && !r.jev.has_chair_reference) return false;
        if (currentFilter === 'insult' && !r.jev.has_insult) return false;
        if (currentFilter === 'approved' && r.jev.recommended_action !== 'publicar_directo') return false;
        if (currentFilter === 'discard' && r.jev.recommended_action !== 'descartar') return false;

        // Search text
        if (q && !r.original_text.toLowerCase().includes(q) && !r.anonymized_text.toLowerCase().includes(q)) {
          return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        resultsTbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-dim); padding: 40px;">No hay resultados con los filtros seleccionados.</td></tr>`;
        return;
      }

      resultsTbody.innerHTML = filtered.map(row => {
        const jev = row.jev;
        const toxClass = jev.toxicity_score >= 4 ? 'color: #f87171;' : (jev.toxicity_score >= 2.5 ? 'color: #fbbf24;' : 'color: #34d399;');
        const toxBarWidth = `${(jev.toxicity_score / 5) * 100}%`;
        const actionLabel = jev.recommended_action.replace('_', ' ');

        return `
          <tr data-index="${row.row_index}">
            <td style="color: var(--text-dim); font-family: var(--font-mono);">${row.row_index + 1}</td>
            <td>
              <div class="text-comment-box">${row.highlighted_html}</div>
            </td>
            <td>
              <div class="anonymized-box" contenteditable="true" data-index="${row.row_index}" title="Haga clic para editar la versión anonimizada">${row.anonymized_text}</div>
            </td>
            <td>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <span class="badge-pill ${jev.has_person_name ? 'true' : 'false'}">
                  PER: ${(jev.prob_person_name * 100).toFixed(0)}%
                </span>
                <span class="badge-pill ${jev.has_chair_reference ? 'true' : 'false'}">
                  Cátedra: ${(jev.prob_chair_reference * 100).toFixed(0)}%
                </span>
                <span class="badge-pill ${jev.has_insult ? 'true' : 'false'}">
                  Insulto: ${(jev.prob_insult * 100).toFixed(0)}%
                </span>
              </div>
            </td>
            <td style="white-space: nowrap;">
              <strong style="${toxClass}">${jev.toxicity_score} / 5</strong>
              <div style="width: 70px; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; margin-top: 4px; overflow: hidden;">
                <div style="height: 100%; width: ${toxBarWidth}; background: ${jev.toxicity_score >= 4 ? '#ef4444' : (jev.toxicity_score >= 2.5 ? '#f59e0b' : '#10b981')};"></div>
              </div>
            </td>
            <td>
              <span style="font-size: 0.78rem; text-transform: capitalize; color: var(--text-muted);">${jev.primary_topic}</span>
            </td>
            <td>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <span class="action-chip ${jev.recommended_action}">${actionLabel}</span>
                <label style="font-size: 0.75rem; color: var(--text-muted); display: flex; align-items: center; gap: 4px; cursor: pointer;">
                  <input type="checkbox" class="chk-include-row" data-index="${row.row_index}" ${row.include_in_export ? 'checked' : ''} />
                  Incluir en exportación
                </label>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // Add listeners for row inclusion toggle
      document.querySelectorAll('.chk-include-row').forEach(chk => {
        chk.addEventListener('change', (e) => {
          const idx = parseInt(e.target.getAttribute('data-index'));
          processedResults[idx].include_in_export = e.target.checked;
        });
      });

      // Add listeners for editable anonymized box
      document.querySelectorAll('.anonymized-box[contenteditable]').forEach(box => {
        box.addEventListener('blur', (e) => {
          const idx = parseInt(e.target.getAttribute('data-index'));
          processedResults[idx].anonymized_text = e.target.innerText;
        });
      });
    }

    // Filter Buttons
    document.querySelectorAll('.filter-pill[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-pill[data-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter');
        renderResultsTable(processedResults);
      });
    });

    // Search input
    searchInput.addEventListener('input', () => {
      renderResultsTable(processedResults);
    });

    // Playground Logic
    const singleTextInput = document.getElementById('single-text-input');
    const btnRunSingle = document.getElementById('btn-run-single');
    const singleResultBox = document.getElementById('single-result-box');
    const singleHighlighted = document.getElementById('single-highlighted');
    const singleAnonymized = document.getElementById('single-anonymized');
    const singleMetricsChips = document.getElementById('single-metrics-chips');

    document.querySelectorAll('.sample-prompt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        singleTextInput.value = btn.getAttribute('data-text');
        btnRunSingle.click();
      });
    });

    btnRunSingle.addEventListener('click', async () => {
      const text = singleTextInput.value.trim();
      if (!text) {
        showToast('Escriba un texto para analizar', '⚠️');
        return;
      }

      btnRunSingle.disabled = true;
      btnRunSingle.textContent = 'Evaluando con Jev...';

      try {
        const res = await fetch(`${API_BASE}/api/analyze-single`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text })
        });
        const data = await res.json();

        singleResultBox.style.display = 'block';
        singleHighlighted.innerHTML = data.highlighted_html;
        singleAnonymized.textContent = data.anonymized_text;

        const jev = data.jev;
        singleMetricsChips.innerHTML = `
          <div class="kpi-card" style="padding: 10px 14px; min-width: 140px;">
            <div class="kpi-label">Persona (PER)</div>
            <div class="kpi-value" style="font-size: 1.2rem;">${(jev.prob_person_name * 100).toFixed(0)}%</div>
            <div class="kpi-sub">${jev.has_person_name ? 'Detectada' : 'No detectada'}</div>
          </div>
          <div class="kpi-card" style="padding: 10px 14px; min-width: 140px;">
            <div class="kpi-label">Cátedra / Materia</div>
            <div class="kpi-value" style="font-size: 1.2rem;">${(jev.prob_chair_reference * 100).toFixed(0)}%</div>
            <div class="kpi-sub">${jev.has_chair_reference ? 'Detectada' : 'No detectada'}</div>
          </div>
          <div class="kpi-card" style="padding: 10px 14px; min-width: 140px;">
            <div class="kpi-label">Insulto / Inapropiado</div>
            <div class="kpi-value" style="font-size: 1.2rem;">${(jev.prob_insult * 100).toFixed(0)}%</div>
            <div class="kpi-sub">${jev.has_insult ? 'Detectado' : 'No detectado'}</div>
          </div>
          <div class="kpi-card" style="padding: 10px 14px; min-width: 140px;">
            <div class="kpi-label">Toxicidad Jev</div>
            <div class="kpi-value" style="font-size: 1.2rem;">${jev.toxicity_score} / 5</div>
            <div class="kpi-sub">${jev.primary_topic}</div>
          </div>
          <div class="kpi-card" style="padding: 10px 14px; min-width: 160px;">
            <div class="kpi-label">Acción Sugerida</div>
            <div class="kpi-value" style="font-size: 1rem;"><span class="action-chip ${jev.recommended_action}">${jev.recommended_action}</span></div>
            <div class="kpi-sub">Moderación</div>
          </div>
        `;

        showToast('Respuesta evaluada con éxito', '⚡');
      } catch (e) {
        showToast('Error al analizar comentario', '❌');
      } finally {
        btnRunSingle.disabled = false;
        btnRunSingle.textContent = '⚡ Analizar con TypeSafe Jev (100ms)';
      }
    });

    // Export Logic
    const btnDoExport = document.getElementById('btn-do-export');
    btnDoExport.addEventListener('click', async () => {
      if (!currentSessionId || processedResults.length === 0) {
        showToast('Primero cargue y analice una encuesta', '⚠️');
        return;
      }

      const format = document.querySelector('input[name="export-format"]:checked').value;
      const mode = document.getElementById('export-mode-select').value;
      const excludeDiscarded = document.getElementById('chk-exclude-discarded').checked;

      btnDoExport.disabled = true;
      btnDoExport.textContent = 'Generando archivo...';

      try {
        const res = await fetch(`${API_BASE}/api/export`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            session_id: currentSessionId,
            filename: currentFilename,
            text_column: selectTextColumn ? selectTextColumn.value : 'comentario',
            export_format: format,
            mode: mode,
            exclude_discarded: excludeDiscarded,
            custom_rows: processedResults
          })
        });

        if (!res.ok) throw new Error('Error al exportar');

        const blob = await res.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.style.display = 'none';
        a.href = url;
        a.download = format === 'csv' ? 'encuesta_estudiantes_limpia.csv' : 'encuesta_estudiantes_limpia.xlsx';
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);

        showToast('¡Descarga iniciada con éxito!', '📥');
      } catch (e) {
        showToast('Error al exportar archivo', '❌');
      } finally {
        btnDoExport.disabled = false;
        btnDoExport.textContent = '📥 Descargar Planilla Limpia para Publicación';
      }
    });
  </script>
</body>
</html>
